generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TutorProfile {
  id               String          @id @default(uuid())
  headline         String? // Professional hook (e.g., "Senior Software Engineer @ TechCorp | 5yrs Teaching Next.js")
  bio              String? // Short bio
  bio_long         String? // Rich text - detailed teaching methodology
  intro_video_url  String? // Link to 30-second YouTube/Vimeo introduction
  badges           String[]        @default([]) // ["Verified", "Fast Responder", "Top 1%"]
  experience_years Int? // Quantifiable professional background
  languages        Json? // Array of objects: [{ lang: "English", level: "Native" }]
  education        Json? // Array: [{ degree: "B.S.", field: "Computer Science", school: "MIT", year: 2020, verified: true }]
  avatar_url       String? // High-resolution avatar
  id_verified      Boolean         @default(false) // Verification status for ID documents
  hourlyRate       Decimal
  averageRate      Decimal         @default(0.00)
  experience       Int
  profile_draft    Json? // Draft data for unsaved changes
  is_published     Boolean         @default(false) // Publish status for profile
  studentId        String          @unique // Legacy field - can be deprecated
  createdAt        DateTime        @default(now()) @db.Timestamp(6)
  updatedAt        DateTime        @default(now()) @updatedAt @db.Timestamp(6)
  availabilities   Availability[]
  bookings         Booking[]
  Student          User            @relation(fields: [studentId], references: [id])
  tutorSubjects    TutorSubjects[]

  @@index([hourlyRate])
  @@index([averageRate])
  @@index([is_published])
  @@index([id_verified])
}

model Booking {
  id          String        @id @default(uuid())
  studentId   String
  tutorId     String
  totalPrice  Decimal
  startTime   DateTime
  endTime     DateTime
  meetingLink String?
  status      Booked_Status @default(pending)
  Student     User          @relation(fields: [studentId], references: [id])
  Tutor       TutorProfile  @relation(fields: [tutorId], references: [id])
  reviews     Reviews[]

  @@index([totalPrice])
}

model Availability {
  id        String       @id @default(uuid())
  tutorId   String
  dayOfWeek Week
  startTime String
  endTime   String
  Tutor     TutorProfile @relation(fields: [tutorId], references: [id])

  @@unique([tutorId, dayOfWeek, startTime, endTime])
  @@index([dayOfWeek, startTime, endTime])
}

model Category {
  id            Int             @id @default(autoincrement())
  categoryName  String
  description   String?
  icon          String?
  isTrending    Boolean         @default(false)
  learnerCount  Int             @default(0)
  startingPrice Decimal?
  tags          String[]        @default([])
  tutorSubjects TutorSubjects[]
}

model TutorSubjects {
  tutorId    String
  categoryId Int
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  Tutor      TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@id([tutorId, categoryId])
}

model Reviews {
  id        String  @id @default(uuid())
  comment   String
  bookingId String
  rating    Decimal @default(0.00)
  booking   Booking @relation(fields: [bookingId], references: [id])

  @@index([rating])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  User                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  password      String?
  role          Role?         @default(STUDENT)
  isBanned      Boolean?      @default(false)
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  Account       Account[]
  bookings      Booking[]
  Session       Session[]
  tutorProfile  TutorProfile?

  @@index([name])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([identifier])
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum Booked_Status {
  pending
  confirmed
  completed
  cancelled
}

enum Week {
  sat
  sun
  mon
  tue
  wed
  thu
  fri
}
